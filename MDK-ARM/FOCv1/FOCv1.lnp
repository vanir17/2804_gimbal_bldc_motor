--cpu Cortex-M3
"focv1\startup_stm32f103xb.o"
"focv1\main.o"
"focv1\stm32f1xx_it.o"
"focv1\stm32f1xx_hal_msp.o"
"focv1\stm32f1xx_hal_gpio_ex.o"
"focv1\stm32f1xx_hal_i2c.o"
"focv1\stm32f1xx_hal.o"
"focv1\stm32f1xx_hal_rcc.o"
"focv1\stm32f1xx_hal_rcc_ex.o"
"focv1\stm32f1xx_hal_gpio.o"
"focv1\stm32f1xx_hal_dma.o"
"focv1\stm32f1xx_hal_cortex.o"
"focv1\stm32f1xx_hal_pwr.o"
"focv1\stm32f1xx_hal_flash.o"
"focv1\stm32f1xx_hal_flash_ex.o"
